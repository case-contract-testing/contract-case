{
  "name": "@contract-case/eslint-config-case-maintainer",
  "version": "0.31.2",
  "description": "eslint settings for contract-case modules. Only useful for ContractCase maintainers",
  "keywords": [
    "contractcase"
  ],
  "author": "Timothy Jones <timothy.l.jones@gmail.com> (https://github.com/TimothyJones)",
  "homepage": "https://case.contract-testing.io",
  "license": "BSD-3-Clause",
  "main": "eslint.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:case-contract-testing/contract-case.git"
  },
  "scripts": {
    "format:base": "prettier \"*.{ts,js}\"",
    "format:check": "npm run format:base -- --list-different",
    "format:fix": "npm run format:base -- --write "
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/TimothyJones"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/case-contract-testing/case/issues"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.12.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
